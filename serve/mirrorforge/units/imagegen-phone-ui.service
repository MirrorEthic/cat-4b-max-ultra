[Unit]
Description=Imagegen Phone UI (FastAPI on :8189)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/garret/comfyui
Environment=HOME=/home/garret
ExecStart=/home/garret/comfyui/venv/bin/python -m uvicorn extras.phone_ui:app --host 0.0.0.0 --port 8189
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
